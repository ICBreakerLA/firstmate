import ctypes, subprocess, sys, time
libc = ctypes.CDLL("libc.so.6")
if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
    sys.exit(1)
child = subprocess.Popen(["sleep", "300"])
with open(sys.argv[1], "w") as fh:
    fh.write(str(child.pid))
time.sleep(600)
